    "Observed": {
      "allOf": [
        {
          "else": {
            "properties": {
              "observed_at": {
                "type": "null"
              },
              "reason": {
                "not": {
                  "type": "null"
                }
              },
              "value": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "availability": {
                "const": "available"
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "observed_at": {
                "minimum": 0,
                "type": "integer"
              },
              "reason": {
                "type": "null"
              },
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ],
      "description": "A missing value never represents a successful observation. Constructors and JSON validate this invariant.",
      "properties": {
        "availability": {
          "$ref": "#/$defs/Availability"

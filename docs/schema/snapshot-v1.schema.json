      "properties": {
        "charge_percent": {
          "$ref": "#/$defs/Observed7",
          "default": {
            "availability": "unsupported",
            "observed_at": null,
            "reason": "not_supported",
            "source": "custom",
            "value": null
          },
          "description": "Fresh reported percentage, not a remaining-time or health estimate."
        },
        "on_ac_power": {
          "$ref": "#/$defs/Observed9",
          "default": {
            "availability": "unsupported",
            "observed_at": null,
            "reason": "not_supported",
            "source": "custom",
            "value": null
          },
          "description": "OS-reported AC state. Linux aggregates only Mains supplies: any known online\nis true; all known offline is false. No Mains is unavailable; charging and\nUSB/Wireless status do not imply AC. Applies to each battery, not its wiring."
        }

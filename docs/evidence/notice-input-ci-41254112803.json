    "helper_utf8": "import hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport subprocess\nimport sys\nfrom unittest.mock import patch\n\nROOT = Path(__file__).resolve().parent.parent\nsys.path.insert(0, str(ROOT/'scripts'))\nimport cli_bundle\nimport notice_audit\n\nSOURCE = 'cb80fa88d05c25e68f2f18118eb29fabc2bc498f'\nassert os.name == 'nt'\nbefore = notice_audit.source_state()\nassert before == (SOURCE, '')\nfolder = ROOT/'target/notice-input-junction-cb80fa8'\nlink = folder/'dep/NOTICE'\ninfo = link.lstat()\nassert info.st_file_attributes & cli_bundle.REPARSE_POINT\nassert info.st_reparse_tag == 0xA0000003  # IO_REPARSE_TAG_MOUNT_POINT (junction).\nmetadata = {\n    'packages': [\n        {'id':'cli','name':'daoseeker-scope-cli','source':None},\n        {'id':'dep','name':'synthetic-dep','version':'1','source':'registry+fixture','license':'MIT','manifest_path':str(folder/'dep/Cargo.toml')},\n    ],\n    'resolve':{'nodes':[\n        {'id':'cli','deps':[{'pkg':'dep','dep_kinds':[{'kind':None}]}]},\n        {'id':'dep','deps':[]},\n    ]},\n}\nwith patch.object(cli_bundle.os,'open',side_effect=AssertionError('notice must not be opened')) as opened:\n    try:\n        cli_bundle.dependency_payload(metadata)\n    except ValueError as error:\n        assert str(error) == 'unsafe_notice_file'\n    else:\n        raise AssertionError('junction accepted')\n    audit = notice_audit.inventory(metadata,'daoseeker-scope-cli')\n    assert audit['blocking_packages'] == 1 and audit['packages'][0]['errors'] == ['unsafe_notice_file']\n    opened.assert_not_called()\nafter = notice_audit.source_state()\nassert after == before\nreport = {\n    'overall':'passed','source_before':{'revision':before[0],'status':before[1]},'source_after':{'revision':after[0],'status':after[1]},\n    'real_windows_junction':True,'synthetic_contents':True,'reparse_tag':info.st_reparse_tag,\n    'ordinary_license_present':(folder/'dep/LICENSE').is_file(),'rejected_before_read':True,'packager_notice_gate':audit['packager_notice_gate'],\n    'errors':audit['packages'][0]['errors'],'published':False,\n    'helper_sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),\n    'limits':'Local synthetic package and real NTFS junction; not a concurrent mutation or general filesystem sandbox test.',\n}\n(ROOT/'target/notice-input-junction-evidence.json').write_bytes((json.dumps(report,indent=2)+'\\n').encode())\nprint(json.dumps(report,indent=2))\n",
    "helper_sha256": "bfeeca70575de3c1c8209566a75660bec3fcd39fab430a9e79f4f70a29eb0871",
